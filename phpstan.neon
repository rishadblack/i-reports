includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - config
        - database
    excludePaths:
        - src/routes/web.php
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Eloquent builders flow through untyped report classes written by package users.
        - identifier: missingType.generics
        # Package views live outside resource_path(), so Larastan cannot see them.
        - message: '#expects view-string#'
        # The package config is a config file; env() is correct there once published.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/i-reports.php
