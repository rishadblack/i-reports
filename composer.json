{
    "name": "rishadblack/i-reports",
    "description": ":Reusable and extensible Laravel reporting package featuring dynamic report loading, Livewire-driven filters, export to PDF and Excel using blade views, and support for modular applications.",
    "license": "MIT",
    "authors": [
        {
            "name": "S M Rishad",
            "email": "rishad.black@gmail.com",
            "homepage": "https://smrishad.com"
        }
    ],
    "homepage": "https://github.com/rishadblack/i-reports",
    "keywords": [
        "Laravel",
        "IReports"
    ],
    "version": "0.1.7",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "maatwebsite/excel": "^3.1",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Rishadblack\\IReports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rishadblack\\IReports\\Tests\\": "tests",
            "App\\": "tests/Fixtures/app/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rishadblack\\IReports\\IReportsServiceProvider"
            ],
            "aliases": {
                "IReports": "Rishadblack\\IReports\\Facades\\IReports"
            }
        }
    }
}
