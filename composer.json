{
    "name": "rishadblack/i-reports",
    "description": "Paginated, filterable Laravel reports with Livewire, print, PDF, Excel and CSV export from one Blade view.",
    "license": "MIT",
    "authors": [
        {
            "name": "S M Rishad",
            "email": "rishad.black@gmail.com",
            "homepage": "https://smrishad.com"
        }
    ],
    "homepage": "https://github.com/rishadblack/i-reports",
    "keywords": [
        "laravel",
        "livewire",
        "reports",
        "pdf",
        "excel",
        "csv",
        "export"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "maatwebsite/excel": "^3.1|^4.0",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Rishadblack\\IReports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rishadblack\\IReports\\Tests\\": "tests",
            "App\\": "tests/Fixtures/app/",
            "Modules\\": "tests/Fixtures/Modules/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --compact",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rishadblack\\IReports\\IReportsServiceProvider"
            ],
            "aliases": {
                "IReports": "Rishadblack\\IReports\\Facades\\IReports"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
